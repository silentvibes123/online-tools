Redirect 301 /pdf-to-word https://www.swifttoolpro.com/
Redirect 301 /word-to-pdf https://www.swifttoolpro.com/
RewriteEngine On

# 1. Sab kuch HTTPS par redirect karo (Ye sahi hai, rehne do)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Non-WWW ko WWW par redirect karo (Ye naya code hai)
RewriteCond %{HTTP_HOST} ^swifttoolpro\.com [NC]
RewriteRule ^(.*)$ https://www.swifttoolpro.com/$1 [L,R=301]