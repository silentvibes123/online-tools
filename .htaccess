RewriteEngine On

# 1. Sabhi traffic ko HTTPS par bhejo
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. WWW ko Non-WWW par redirect karo (Taaki 5xx error khatam ho)
RewriteCond %{HTTP_HOST} ^www\.swifttoolpro\.com [NC]
RewriteRule ^(.*)$ https://swifttoolpro.com/$1 [L,R=301]

# 3. Aapka purana code (Routing)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [QSA,L]