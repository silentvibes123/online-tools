RewriteEngine On

# ============================================================
# STEP 1: Force HTTPS + WWW in ONE single redirect (no chain)
# This fixes "Page with redirect" in Search Console
# Both http://swifttoolpro.com AND http://www.swifttoolpro.com
# AND https://swifttoolpro.com all go to https://www.swifttoolpro.com
# ============================================================

# Redirect http://swifttoolpro.com/* → https://www.swifttoolpro.com/*
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^swifttoolpro\.com$ [NC]
RewriteRule ^(.*)$ https://www.swifttoolpro.com/$1 [L,R=301]

# Redirect http://www.swifttoolpro.com/* → https://www.swifttoolpro.com/*
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^www\.swifttoolpro\.com$ [NC]
RewriteRule ^(.*)$ https://www.swifttoolpro.com/$1 [L,R=301]

# Redirect https://swifttoolpro.com/* → https://www.swifttoolpro.com/*
RewriteCond %{HTTPS} on
RewriteCond %{HTTP_HOST} ^swifttoolpro\.com$ [NC]
RewriteRule ^(.*)$ https://www.swifttoolpro.com/$1 [L,R=301]

# ============================================================
# STEP 2: Old/deleted tool URLs → Home (301)
# ============================================================
RewriteRule ^pdf-to-word$ https://www.swifttoolpro.com/ [L,R=301]
RewriteRule ^word-to-pdf$ https://www.swifttoolpro.com/ [L,R=301]

# ============================================================
# STEP 3: Security Headers
# ============================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============================================================
# STEP 4: Browser Caching
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ============================================================
# STEP 5: GZIP Compression
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================================
# STEP 6: 404 → index.html (SPA routing)
# ============================================================
ErrorDocument 404 /index.html
