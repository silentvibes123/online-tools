RewriteEngine On

# ============================================================
# STEP 1: Force HTTPS + WWW — no redirect chain
# ============================================================

# http://swifttoolpro.com → https://www.swifttoolpro.com (single hop)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^swifttoolpro\.com$ [NC]
RewriteRule ^(.*)$ https://www.swifttoolpro.com/$1 [L,R=301]

# http://www.swifttoolpro.com → https://www.swifttoolpro.com (single hop)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^www\.swifttoolpro\.com$ [NC]
RewriteRule ^(.*)$ https://www.swifttoolpro.com/$1 [L,R=301]

# https://swifttoolpro.com → https://www.swifttoolpro.com (single hop)
RewriteCond %{HTTPS} on
RewriteCond %{HTTP_HOST} ^swifttoolpro\.com$ [NC]
RewriteRule ^(.*)$ https://www.swifttoolpro.com/$1 [L,R=301]

# ============================================================
# STEP 1B: Remove trailing slash from non-index pages (canonical cleanup)
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^(.+)/$ /$1 [L,R=301]

# ============================================================
# STEP 2: Old/deleted tool URLs → Home (301)
# ============================================================
RewriteRule ^pdf-to-word$ https://www.swifttoolpro.com/ [L,R=301]
RewriteRule ^word-to-pdf$ https://www.swifttoolpro.com/ [L,R=301]
RewriteRule ^wordToPdf$ https://www.swifttoolpro.com/ [L,R=301]
RewriteRule ^wordToPdf\.html$ https://www.swifttoolpro.com/ [L,R=301]

# ============================================================
# STEP 2B: .html tool files → clean SPA URLs (301)
# Fixes "Duplicate canonical" — all tool .html files redirect to clean URLs
# ============================================================
RewriteRule ^cash\.html$ https://www.swifttoolpro.com/cash [L,R=301]
RewriteRule ^gst\.html$ https://www.swifttoolpro.com/gst [L,R=301]
RewriteRule ^age\.html$ https://www.swifttoolpro.com/age [L,R=301]
RewriteRule ^emi\.html$ https://www.swifttoolpro.com/emi [L,R=301]
RewriteRule ^base64\.html$ https://www.swifttoolpro.com/base64 [L,R=301]
RewriteRule ^caseConverter\.html$ https://www.swifttoolpro.com/caseConverter [L,R=301]
RewriteRule ^imageToText\.html$ https://www.swifttoolpro.com/imageToText [L,R=301]
RewriteRule ^aiVoice\.html$ https://www.swifttoolpro.com/voice [L,R=301]
RewriteRule ^compressor\.html$ https://www.swifttoolpro.com/compress [L,R=301]
RewriteRule ^imgToPdf\.html$ https://www.swifttoolpro.com/pdf [L,R=301]
RewriteRule ^image-resizer\.html$ https://www.swifttoolpro.com/resizer [L,R=301]
RewriteRule ^loremIpsum\.html$ https://www.swifttoolpro.com/loremIpsum [L,R=301]
RewriteRule ^pdfToImg\.html$ https://www.swifttoolpro.com/pdfToImg [L,R=301]
RewriteRule ^qr\.html$ https://www.swifttoolpro.com/qrcode [L,R=301]
RewriteRule ^removePages\.html$ https://www.swifttoolpro.com/removePages [L,R=301]
RewriteRule ^stopwatch\.html$ https://www.swifttoolpro.com/stopwatch [L,R=301]
RewriteRule ^wordCounter\.html$ https://www.swifttoolpro.com/wordCounter [L,R=301]
RewriteRule ^password\.html$ https://www.swifttoolpro.com/password [L,R=301]
RewriteRule ^percentage\.html$ https://www.swifttoolpro.com/percentage [L,R=301]
RewriteRule ^unitConverter\.html$ https://www.swifttoolpro.com/unitConverter [L,R=301]
RewriteRule ^split\.html$ https://www.swifttoolpro.com/split [L,R=301]
RewriteRule ^merge\.html$ https://www.swifttoolpro.com/merge [L,R=301]
RewriteRule ^pdf\.html$ https://www.swifttoolpro.com/pdf [L,R=301]
RewriteRule ^resizer\.html$ https://www.swifttoolpro.com/resizer [L,R=301]

# ============================================================
# STEP 3: Block ?q= search param URL — return 410 Gone (removes from index)
# ============================================================
RewriteCond %{QUERY_STRING} ^q=
RewriteRule ^$ - [G,L]

# Block any other query string on homepage
RewriteCond %{QUERY_STRING} .+
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ https://www.swifttoolpro.com/? [L,R=301]

# ============================================================
# STEP 4: SPA Tool URL Routing — serve index.html for all clean tool URLs
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(resizer|compress|pdf|pdfToImg|merge|split|removePages|pdfToWord|cash|gst|age|qrcode|voice|wordCounter|password|base64|unitConverter|loremIpsum|emi|imageToText|percentage|caseConverter|stopwatch|video-to-mp3)$ /index.html [L]

# ============================================================
# STEP 4: Security Headers
# ============================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============================================================
# STEP 5: Browser Caching
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ============================================================
# STEP 6: GZIP Compression
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================================
# STEP 7: 404 → index.html (fallback for any unknown SPA route)
# ============================================================
ErrorDocument 404 /index.html
