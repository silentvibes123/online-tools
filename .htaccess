RewriteEngine On

# ============================================================
# 1. CANONICAL DOMAIN
#    Everything → https://www.swifttoolpro.com
# ============================================================

# http://swifttoolpro.com/* → https://www.swifttoolpro.com/*
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^swifttoolpro\.com$ [NC]
RewriteRule ^(.*)$ https://www.swifttoolpro.com/$1 [R=301,L]

# http://www.swifttoolpro.com/* → https://www.swifttoolpro.com/*
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^www\.swifttoolpro\.com$ [NC]
RewriteRule ^(.*)$ https://www.swifttoolpro.com/$1 [R=301,L]

# https://swifttoolpro.com/* → https://www.swifttoolpro.com/*
RewriteCond %{HTTPS} on
RewriteCond %{HTTP_HOST} ^swifttoolpro\.com$ [NC]
RewriteRule ^(.*)$ https://www.swifttoolpro.com/$1 [R=301,L]


# ============================================================
# 2. REMOVE TRAILING SLASH FROM NON-DIRECTORY PAGES
# ============================================================

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]


# ============================================================
# 3. OLD / DELETED URLs → HOMEPAGE
# ============================================================

RewriteRule ^pdf-to-word$ https://www.swifttoolpro.com/ [R=301,L]
RewriteRule ^word-to-pdf$ https://www.swifttoolpro.com/ [R=301,L]
RewriteRule ^wordToPdf$ https://www.swifttoolpro.com/ [R=301,L]
RewriteRule ^wordToPdf\.html$ https://www.swifttoolpro.com/ [R=301,L]


# ============================================================
# 4. OLD .HTML TOOL URLs → CURRENT CLEAN TOOL URLs
# ============================================================

RewriteRule ^cash\.html$ https://www.swifttoolpro.com/cash [R=301,L]
RewriteRule ^gst\.html$ https://www.swifttoolpro.com/gst [R=301,L]
RewriteRule ^age\.html$ https://www.swifttoolpro.com/age [R=301,L]
RewriteRule ^emi\.html$ https://www.swifttoolpro.com/emi [R=301,L]
RewriteRule ^base64\.html$ https://www.swifttoolpro.com/base64 [R=301,L]
RewriteRule ^caseConverter\.html$ https://www.swifttoolpro.com/caseConverter [R=301,L]
RewriteRule ^imageToText\.html$ https://www.swifttoolpro.com/imageToText [R=301,L]
RewriteRule ^aiVoice\.html$ https://www.swifttoolpro.com/voice [R=301,L]
RewriteRule ^compressor\.html$ https://www.swifttoolpro.com/compress [R=301,L]
RewriteRule ^imgToPdf\.html$ https://www.swifttoolpro.com/pdf [R=301,L]
RewriteRule ^image-resizer\.html$ https://www.swifttoolpro.com/resizer [R=301,L]
RewriteRule ^loremIpsum\.html$ https://www.swifttoolpro.com/loremIpsum [R=301,L]
RewriteRule ^pdfToImg\.html$ https://www.swifttoolpro.com/pdfToImg [R=301,L]
RewriteRule ^qr\.html$ https://www.swifttoolpro.com/qrcode [R=301,L]
RewriteRule ^removePages\.html$ https://www.swifttoolpro.com/removePages [R=301,L]
RewriteRule ^stopwatch\.html$ https://www.swifttoolpro.com/stopwatch [R=301,L]
RewriteRule ^wordCounter\.html$ https://www.swifttoolpro.com/wordCounter [R=301,L]
RewriteRule ^password\.html$ https://www.swifttoolpro.com/password [R=301,L]
RewriteRule ^percentage\.html$ https://www.swifttoolpro.com/percentage [R=301,L]
RewriteRule ^unitConverter\.html$ https://www.swifttoolpro.com/unitConverter [R=301,L]
RewriteRule ^split\.html$ https://www.swifttoolpro.com/split [R=301,L]
RewriteRule ^merge\.html$ https://www.swifttoolpro.com/merge [R=301,L]
RewriteRule ^pdf\.html$ https://www.swifttoolpro.com/pdf [R=301,L]
RewriteRule ^resizer\.html$ https://www.swifttoolpro.com/resizer [R=301,L]


# ============================================================
# 5. REMOVE UNWANTED HOMEPAGE QUERY URLS
# ============================================================

# Example:
# https://www.swifttoolpro.com/?q=something
# → https://www.swifttoolpro.com/
#
# 410 Gone tells Google this URL should not exist.
RewriteCond %{QUERY_STRING} (^|&)q= [NC]
RewriteRule ^$ - [G,L]


# ============================================================
# 6. CLEAN OTHER HOMEPAGE QUERY STRINGS
# ============================================================

# https://www.swifttoolpro.com/?anything
# → https://www.swifttoolpro.com/
RewriteCond %{QUERY_STRING} .+
RewriteRule ^$ https://www.swifttoolpro.com/ [R=301,L,NE]


# ============================================================
# 7. VALID SPA TOOL ROUTES
#    ONLY known tool URLs are allowed to load index.html
# ============================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(resizer|compress|pdf|pdfToImg|merge|split|removePages|cash|gst|age|qrcode|voice|wordCounter|password|base64|unitConverter|loremIpsum|emi|imageToText|percentage|caseConverter|stopwatch|video-to-mp3)$ /index.html [L]


# ============================================================
# 8. SECURITY HEADERS
# ============================================================

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>


# ============================================================
# 9. BROWSER CACHING
# ============================================================

<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"

    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/json "access plus 1 day"

    ExpiresByType text/html "access plus 1 hour"
</IfModule>


# ============================================================
# 10. GZIP COMPRESSION
# ============================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>